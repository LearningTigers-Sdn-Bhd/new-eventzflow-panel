{
  "contextFileName": "AGENTS.md",
  "mcpServers": {
    "context7": {
      "command": "bunx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ],
      "type": "stdio"
    },
    "shadcn": {
      "command": "bunx",
      "args": [
        "shadcn@latest",
        "mcp"
      ],
      "type": "stdio"
    },
    "next-devtools": {
      "command": "bunx",
      "args": [
        "-y",
        "next-devtools-mcp@latest"
      ],
      "type": "stdio"
    }
  }
}